# Demo uses no keys. Jev sees images and sampled video frames directly. Speech transcription is optional.
ANALYSIS_PROVIDER=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Optional: collect from Meta instead of importing files
APIFY_TOKEN=
# Optional: transcribe video uploads; choose fireworks or groq
TRANSCRIPTION_PROVIDER=fireworks
FIREWORKS_API_KEY=
GROQ_API_KEY=
# Optional: generate original briefs using an compatible chat API.
# Without these, the app produces clearly labeled editable brief outlines.
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_API_KEY=
LLM_MODEL=
PORT=5194
